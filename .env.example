# ============================================================
# Fraud Detection Multi-Agent System — Environment Config
# ============================================================
# Copy to .env and fill in your values.

# --- LLM Provider -------------------------------------------
# "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_AGENT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-20250514

# --- LangSmith (optional tracing) ---------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=fraud-detection-prod

# --- Vector Store -------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=fraud_knowledge_base

# --- Application --------------------------------------------
APP_ENV=development                # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | text

# --- Rate Limiting ------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Feature Flags ------------------------------------------
ENABLE_RERANKING=false
ENABLE_PROMETHEUS=true
ENABLE_LANGSMITH_TRACING=false

# --- Fraud Thresholds (override agent_config.yaml defaults) --
# RISK_HIGH_THRESHOLD=0.7
# RISK_CRITICAL_THRESHOLD=0.9
